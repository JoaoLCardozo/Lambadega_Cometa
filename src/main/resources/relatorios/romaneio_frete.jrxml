<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="romaneio_frete" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail" uuid="dd89251f-0fec-4089-99ea-924895816e02">
    <parameter name="ID_FRETE" class="java.lang.Integer"/>
    <parameter name="DATA_GERACAO" class="java.lang.String"/>
    <queryString>
        <![CDATA[
            SELECT f.numero,
                   f.status,
                   f.data_emissao,
                   f.data_previsao_entrega,
                   f.data_saida,
                   f.data_entrega,
                   f.municipio_origem || '/' || f.uf_origem AS origem,
                   f.municipio_destino || '/' || f.uf_destino AS destino,
                   f.descricao_carga,
                   f.peso_kg,
                   f.volumes,
                   f.valor_frete,
                   f.valor_icms,
                   f.valor_total,
                   r.nome_razao_social AS remetente,
                   r.documento AS documento_remetente,
                   r.telefone AS telefone_remetente,
                   COALESCE(r.logradouro, '') || ', ' || COALESCE(r.numero, '') || ' - ' ||
                   COALESCE(r.municipio, '') || '/' || COALESCE(r.uf, '') AS endereco_remetente,
                   d.nome_razao_social AS destinatario,
                   d.documento AS documento_destinatario,
                   d.telefone AS telefone_destinatario,
                   COALESCE(d.logradouro, '') || ', ' || COALESCE(d.numero, '') || ' - ' ||
                   COALESCE(d.municipio, '') || '/' || COALESCE(d.uf, '') AS endereco_destinatario,
                   m.nome AS motorista,
                   m.cpf AS cpf_motorista,
                   m.cnh_numero AS cnh_motorista,
                   v.placa AS placa_veiculo,
                   v.tipo AS tipo_veiculo
              FROM frete f
              JOIN cliente r ON f.id_remetente = r.id
              JOIN cliente d ON f.id_destinatario = d.id
              JOIN motorista m ON f.id_motorista = m.id
              JOIN veiculo v ON f.id_veiculo = v.id
             WHERE f.id = $P{ID_FRETE}
        ]]>
    </queryString>
    <field name="numero" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="data_emissao" class="java.sql.Timestamp"/>
    <field name="data_previsao_entrega" class="java.sql.Date"/>
    <field name="data_saida" class="java.sql.Timestamp"/>
    <field name="data_entrega" class="java.sql.Timestamp"/>
    <field name="origem" class="java.lang.String"/>
    <field name="destino" class="java.lang.String"/>
    <field name="descricao_carga" class="java.lang.String"/>
    <field name="peso_kg" class="java.math.BigDecimal"/>
    <field name="volumes" class="java.lang.Integer"/>
    <field name="valor_frete" class="java.math.BigDecimal"/>
    <field name="valor_icms" class="java.math.BigDecimal"/>
    <field name="valor_total" class="java.math.BigDecimal"/>
    <field name="remetente" class="java.lang.String"/>
    <field name="documento_remetente" class="java.lang.String"/>
    <field name="telefone_remetente" class="java.lang.String"/>
    <field name="endereco_remetente" class="java.lang.String"/>
    <field name="destinatario" class="java.lang.String"/>
    <field name="documento_destinatario" class="java.lang.String"/>
    <field name="telefone_destinatario" class="java.lang.String"/>
    <field name="endereco_destinatario" class="java.lang.String"/>
    <field name="motorista" class="java.lang.String"/>
    <field name="cpf_motorista" class="java.lang.String"/>
    <field name="cnh_motorista" class="java.lang.String"/>
    <field name="placa_veiculo" class="java.lang.String"/>
    <field name="tipo_veiculo" class="java.lang.String"/>
