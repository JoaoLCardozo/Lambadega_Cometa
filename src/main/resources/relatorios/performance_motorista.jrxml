<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="performance_motorista" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail" uuid="799af21f-f59d-445a-9554-7cdbb6f7f44c">
    <parameter name="ID_MOTORISTA" class="java.lang.Integer"/>
    <parameter name="DATA_INICIO" class="java.sql.Date"/>
    <parameter name="DATA_FIM" class="java.sql.Date"/>
    <parameter name="PERIODO" class="java.lang.String"/>
    <parameter name="DATA_GERACAO" class="java.lang.String"/>
    <queryString>
        <![CDATA[
            SELECT m.nome AS motorista,
                   m.cpf AS cpf_motorista,
                   m.tipo_vinculo AS tipo_vinculo,
                   COUNT(f.id)::integer AS quantidade_fretes,
                   COALESCE(SUM(CASE WHEN f.status = 'ENTREGUE' THEN 1 ELSE 0 END), 0)::integer AS entregas_realizadas,
                   COALESCE(SUM(CASE WHEN f.status = 'ENTREGUE'
                                      AND f.data_entrega::date > f.data_previsao_entrega
                                      THEN 1 ELSE 0 END), 0)::integer AS entregas_atrasadas,
                   COALESCE(SUM(CASE WHEN f.status = 'NAO_ENTREGUE' THEN 1 ELSE 0 END), 0)::integer AS nao_entregas,
                   COALESCE(SUM(f.peso_kg), 0) AS total_transportado_kg,
                   COALESCE(SUM(f.valor_total), 0) AS valor_total_fretes
              FROM motorista m
              LEFT JOIN (
                    SELECT f.*,
                           COALESCE(
                               CASE WHEN f.status = 'ENTREGUE' THEN f.data_entrega::date END,
                               CASE WHEN f.status = 'NAO_ENTREGUE' THEN (
                                   SELECT MAX(oc.data_hora)::date
                                     FROM ocorrencia_frete oc
                                    WHERE oc.id_frete = f.id
                                      AND oc.tipo = 'TENTATIVA_ENTREGA'
                               ) END,
                               f.data_emissao::date
                           ) AS data_referencia
                      FROM frete f
                     WHERE f.status <> 'CANCELADO'
              ) f ON f.id_motorista = m.id
                   AND f.data_referencia BETWEEN $P{DATA_INICIO} AND $P{DATA_FIM}
             WHERE m.id = $P{ID_MOTORISTA}
             GROUP BY m.id, m.nome, m.cpf, m.tipo_vinculo
        ]]>
    </queryString>
    <field name="motorista" class="java.lang.String"/>
    <field name="cpf_motorista" class="java.lang.String"/>
    <field name="tipo_vinculo" class="java.lang.String"/>
    <field name="quantidade_fretes" class="java.lang.Integer"/>
    <field name="entregas_realizadas" class="java.lang.Integer"/>
    <field name="entregas_atrasadas" class="java.lang.Integer"/>
    <field name="nao_entregas" class="java.lang.Integer"/>
    <field name="total_transportado_kg" class="java.math.BigDecimal"/>
    <field name="valor_total_fretes" class="java.math.BigDecimal"/>
